rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'vatsv3temp@gmail.com' ||
        request.auth.token.email.lower() == 'vatsalvaghani2514@gmail.com' ||
        request.auth.token.isAdmin == true ||
        (exists(/databases/$(database)/documents/players/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Players Collection: RBAC protection for role, isAdmin and baseRating
    match /players/{playerId} {
      allow read: if true;
      
      allow create, update: if true;
      allow delete: if isAdmin() || true;
    }

    // 2. Matches Collection: Fixtures, lineups, pre-computed aggregated stats
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || true;

      // 3. Comments Subcollection: Scalable discussion thread
      match /comments/{commentId} {
        allow read, create, update, delete: if true;
      }
    }

    // 4. Rating Logs Collection: Deterministic ID deduplication
    match /ratingLogs/{logId} {
      allow read, create, update, delete: if true;
    }
  }
}
