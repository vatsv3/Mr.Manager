{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Squad player profile and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 100 },
        "photo": { "type": "string" },
        "primaryPosition": { "type": "string", "maxLength": 10 },
        "secondaryPositions": { "type": "array" },
        "traits": { "type": "array" },
        "jerseyNumber": { "type": "number" },
        "nickname": { "type": "string", "maxLength": 50 },
        "baseRating": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "role": { "type": "string", "enum": ["admin", "player", "guest"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "primaryPosition", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Match fixture with lineups, goals, pre-computed stats and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "venue": { "type": "string", "maxLength": 150 },
        "format": { "type": "string" },
        "status": { "type": "string", "enum": ["UPCOMING", "LIVE", "RATING_OPEN", "RATING_CLOSED"] },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "teamA": { "type": "object" },
        "teamB": { "type": "object" },
        "goals": { "type": "array" },
        "mvpPlayerId": { "type": "string" },
        "mvpScore": { "type": "number" },
        "calculatedStats": { "type": "object" },
        "ratingWindowStartedAt": { "type": "string" },
        "ratingWindowEndedAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "status", "format"]
    },
    "MatchComment": {
      "title": "MatchComment",
      "description": "Subcollection comment item for match discussion threads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorName", "content", "createdAt"]
    },
    "RatingLog": {
      "title": "RatingLog",
      "description": "Granular peer rating record with deterministic ID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matchId": { "type": "string" },
        "voterId": { "type": "string" },
        "voterName": { "type": "string", "maxLength": 100 },
        "ratedPlayerId": { "type": "string" },
        "ratedPlayerName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "mvpVotePlayerId": { "type": "string" },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "matchId", "voterId", "ratedPlayerId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Squad player registry"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Match fixtures and aggregated performance stats"
    },
    "/matches/{matchId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/MatchComment" },
      "description": "Subcollection for scalable real-time match comments"
    },
    "/ratingLogs/{logId}": {
      "schema": { "$ref": "#/entities/RatingLog" },
      "description": "Individual peer ballot rating entries with deterministic keys"
    }
  }
}
